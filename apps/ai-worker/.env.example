# mokaid AI worker — local development
PHOENIX_API_URL=http://localhost:4000
WORKER_AUTH_TOKEN=dev-worker-token

# LLM provider (optional in dev — planner falls back to deterministic plans)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Managed Codex execution: remains off until account and pilot verification.
# Also requires workspace consent and Phoenix MANAGED_RUNTIME_VERIFIED_MODELS.
OPENAI_AGENTS_ENABLED=false
OPENAI_AGENTS_STANDARD_MODEL=gpt-6-sol
OPENAI_AGENTS_COMPLEX_MODEL=gpt-6-astra
# Signing secret for POST /webhooks/openai/agents. Never commit real secrets.
OPENAI_AGENTS_WEBHOOK_SECRET=
OPENAI_AGENTS_POLL_SECONDS=2
OPENAI_AGENTS_USAGE_GRACE_SECONDS=60
OPENAI_AGENTS_MAX_ARTIFACT_BYTES=33554432
# JSON array. Empty keeps sandbox network disabled.
OPENAI_AGENTS_ALLOWED_DOMAINS=[]

# Anthropic (Claude) — preferred text provider when set
ANTHROPIC_API_KEY=

# DeepSeek — cheapest tier for bulk/background work.
# When set, "fast" quality routes to DeepSeek V4-Flash instead of Claude.
DEEPSEEK_API_KEY=

# Durable admission, leases, journals and LangGraph checkpoints.
# Required when managed execution is enabled. Memory is dev-only; a configured
# database outage returns 503 or leaves the SQS message pending, never fallback.
DATABASE_URL=postgresql://mokaid:mokaid_dev_password@localhost/mokaid_dev

# LangSmith observability (optional): set the key to trace every agent run.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mokaid-ai-worker

# Optional Tavily key — when set, web_search prefers Tavily over DuckDuckGo.
TAVILY_API_KEY=
# Conservative budget estimate per attempted basic search; adapt to contract.
TAVILY_SEARCH_COST_USD=0.01

# SQS consumption (production only — leave empty in dev, dispatch is HTTP)
AI_RUNS_QUEUE_URL=
AWS_REGION=

# Object storage (MinIO locally, S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=mokaid
S3_SECRET_ACCESS_KEY=mokaid_dev_password
